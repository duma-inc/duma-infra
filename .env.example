COMPOSE_PROJECT_NAME=duma
ENVIRONMENT=development

# =============================================
# POSTGRESQL
# =============================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha
POSTGRES_DB=duma_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================
# MONGODB
# =============================================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=seu_usuario
MONGO_INITDB_ROOT_PASSWORD=sua_senha
MONGO_INITDB_DATABASE=duma_db
MONGODB_URL=mongodb://${MONGO_INITDB_ROOT_USERNAME}:${MONGO_INITDB_ROOT_PASSWORD}@${MONGO_HOST}:${MONGO_PORT}/${MONGO_INITDB_DATABASE}?authSource=admin

# =============================================
# REDIS
# =============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# =============================================
# RABBITMQ
# =============================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=seu_usuario
RABBITMQ_PASSWORD=sua_senha
RABBITMQ_VHOST=duma_vhost
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}

# =============================================
# SERVIÇOS DA APLICAÇÃO
# =============================================

# API
API_PORT=8000
AVA_PORT=3001
ADM_PORT=3002
ENGINE_PORT=3333
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================
# ADM (Next.js / NextAuth)
# =============================================
NEXTAUTH_URL=https://seu-dominio.com
NEXTAUTH_SECRET=gere_um_secret_seguro_aqui
NEXT_PUBLIC_API_URL=https://seu-dominio.com/api
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.seu-dominio.com/realms/duma-realm
KEYCLOAK_ISSUER=https://auth.seu-dominio.com/realms/duma-realm
KEYCLOAK_ISSUER_INTERNAL=http://keycloak:8080/realms/duma-realm
KEYCLOAK_CLIENT_ID=duma-adm
KEYCLOAK_CLIENT_SECRET=seu_client_secret

# =============================================
# DUMA ENGINE (IA)
# =============================================
DEEPSEEK_API_KEY=sua_chave_deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
